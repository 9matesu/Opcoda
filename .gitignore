docs/atlas/*.log

# Atlas: o mermaid.min.js e' de 2,5 MB e a skill do Catlas mantem-no de fora
# do repositorio de proposito. A versao e' fixada no script de render, e o
# ficheiro .sha256 ao lado dele e' o registo do pin.
.opencode/skills/catlas/third_party/mermaid.min.js

# Paginas de render intermedias. O SVG e o PNG ficam versionados.
docs/atlas/assets/render/*.html
